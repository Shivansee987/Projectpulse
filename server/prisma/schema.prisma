generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String

  projects  Project[]

  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?

  startDate   DateTime
  deadline    DateTime

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id])

  tasks Task[]

  createdAt DateTime @default(now())
}

model Task {
  id           String   @id @default(uuid())
  title        String
  duration     Int
  status       String

  assignee     String?

  earliestStart Int?
  latestStart   Int?
  slack         Int?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  dependencies Dependency[] @relation("TaskDependencies")
  dependents   Dependency[] @relation("TaskDependents")
}

model Dependency {
  id String @id @default(uuid())

  taskId String
  dependsOnTaskId String

  task Task @relation(
    "TaskDependencies",
    fields: [taskId],
    references: [id]
  )

  dependsOn Task @relation(
    "TaskDependents",
    fields: [dependsOnTaskId],
    references: [id]
  )
}

model Simulation {
  id String @id @default(uuid())

  taskId String

  originalDuration Int
  simulatedDuration Int

  createdAt DateTime @default(now())
}
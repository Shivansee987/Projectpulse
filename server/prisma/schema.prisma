generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  deadline    DateTime
  ownerId     String
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id])
  tasks       Task[]
}

model Task {
  id            String       @id @default(uuid())
  title         String
  duration      Int
  status        String
  assignee      String?
  earliestStart Int?
  latestStart   Int?
  slack         Int?
  projectId     String
  createdAt     DateTime     @default(now())
  dependents    Dependency[] @relation("TaskDependents")
  dependencies  Dependency[] @relation("TaskDependencies")
  project       Project      @relation(fields: [projectId], references: [id])
}

model Dependency {
  id              String @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  dependsOn       Task   @relation("TaskDependents", fields: [dependsOnTaskId], references: [id])
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id])

  @@unique([taskId, dependsOnTaskId])
}

model Simulation {
  id                String   @id @default(uuid())
  taskId            String
  originalDuration  Int
  simulatedDuration Int
  createdAt         DateTime @default(now())
}
